# Local / OS
.DS_Store
Thumbs.db
desktop.ini

# Print assets (keep offline) — except the guide explaining what's in there,
# which stays tracked so it's not lost/stale across machines. NOTE: must be
# "qr-codes/*" not "qr-codes/" — git can't un-ignore a file inside a
# wholesale-ignored directory, only inside an ignored directory's *contents*.
qr-codes/*
!qr-codes/README.md

# Raw AI-generated source material — only the curated copies inside media/
# are actually used by the site; this folder is just the working stash.
all images/
audio-scripts/*.wav

# TTS iteration drafts (_tts_part.py) — listen/approve locally, then the
# approved file gets copied into media/item-XXX/ by hand.
audio-drafts/
icons/_ai-kalash-raw.jpeg
icons/_ai-kalash-cutout.png
icons/_grid1.jpeg
icons/_grid2.png

# Raw home-decoration photos for the case study — this repo is PUBLIC, and
# these show interior/personal spaces. Keep local-only until the user
# explicitly picks specific images to publish (see CASE-STUDY-DRAFT.md's
# photo-placeholder table).
case study photo/
case-study-assets/

# Backup snapshots of removed items (e.g. backup-removed-items-2026-09-13/) —
# these are working-copy scratch folders, not meant to be public, and their
# own qr-codes/ and media/ subfolders were NOT covered by the top-level
# "qr-codes/*" rule above since it only matches the top-level directory.
# One such backup leaked publicly for this reason — see git history.
backup-removed-items-*/

# Editor
.vscode/
.idea/

# Python helper
__pycache__/
*.pyc
_tmp.webp
.gstack/
